{
  "name": "stock-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:local": "node scripts/db-local.mjs",
    "db:local:seed": "node scripts/db-local.mjs --seed",
    "db:local:reset": "node scripts/db-local.mjs --reset",
    "db:migrate:remote": "wrangler d1 migrations apply stock-db --remote",
    "db:seed:remote": "wrangler d1 execute stock-db --remote --file=./seed.sql",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "html5-qrcode": "^2.3.8",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "workerd": "^1.20261027.1",
    "wrangler": "^4.153.0"
  }
}
